---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import '../styles/rebrand.css';
import CatGlyph from '../components/CatGlyph.astro';
import MeliSprite from '../components/MeliSprite.astro';
import { appLink } from '../config/brand';

const notFoundAppHref = appLink('landing_404');
const routePixels = Array.from({ length: 11 });
---

<Layout
  title="404 · Esta ruta perdió el rastro — GatoPago"
  description="La ruta que buscas no existe o cambió de lugar. Vuelve a GatoPago sin perder el control de tu cuenta."
>
  <main class="meli-landing meli-notfound">
    <a class="meli-skip-link" href="#notfound-content">Saltar al contenido</a>

    <header class="meli-notfound__header">
      <div class="meli-container meli-notfound__nav">
        <a class="meli-notfound__brand" href="/" aria-label="GatoPago — volver al inicio">
          <CatGlyph className="meli-notfound__glyph" decorative />
          <strong>GatoPago</strong>
        </a>
        <span class="meli-notfound__route-label" aria-hidden="true">RUTA · 404</span>
      </div>
    </header>

    <section id="notfound-content" class="meli-notfound__hero" aria-labelledby="notfound-title">
      <div class="meli-container meli-notfound__grid">
        <div class="meli-notfound__copy">
          <p class="meli-kicker"><span aria-hidden="true"></span>Ruta no encontrada</p>
          <h1 id="notfound-title">Esta ruta perdió <em>el rastro.</em></h1>
          <p class="meli-notfound__lead">
            La página que buscas no existe o cambió de lugar. Podemos volver al inicio o abrir directamente tu cuenta.
          </p>

          <div class="meli-notfound__actions">
            <a class="meli-button meli-button--brand meli-button--large" href="/">
              Volver al inicio <span aria-hidden="true">←</span>
            </a>
            <a
              class="meli-button meli-button--secondary meli-button--large"
              href={notFoundAppHref}
              target="_blank"
              rel="noopener noreferrer external"
              data-cta="notfound"
            >
              Abrir GatoPago <span aria-hidden="true">↗</span>
            </a>
          </div>

          <p class="meli-notfound__reassurance">
            <span aria-hidden="true">✓</span>
            Tu cuenta y tu saldo no se movieron.
          </p>
        </div>

        <div
          class="meli-notfound__scene"
          role="img"
          aria-label="Gato pixelado sentado junto a una ruta interrumpida"
        >
          <div class="meli-notfound__corner meli-notfound__corner--top" aria-hidden="true"></div>
          <div class="meli-notfound__corner meli-notfound__corner--bottom" aria-hidden="true"></div>

          <div class="meli-notfound__digits" aria-hidden="true">
            <span>4</span><span>0</span><span>4</span>
          </div>

          <div class="meli-notfound__speech" aria-hidden="true">
            <span></span> ¿ERA POR AQUÍ?
          </div>

          <MeliSprite variant="body-sitting" className="meli-notfound__mascot" loading="eager" />

          <div class="meli-notfound__rail" aria-hidden="true">
            <div class="meli-notfound__rail-labels">
              <span>INICIO</span>
              <span>RUTA INTERRUMPIDA</span>
            </div>
            <div class="meli-notfound__track">
              {routePixels.map((_, index) => (
                <span class:list={{ 'is-missing': index > 7 }}></span>
              ))}
              <i></i>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="meli-notfound__footer">
      <div class="meli-container">
        <span>GatoPago</span>
        <span>Tus dólares ya saben moverse.</span>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .meli-notfound {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background:
      linear-gradient(rgb(11 11 15 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(11 11 15 / 4%) 1px, transparent 1px),
      var(--meli-milk);
    background-size: 32px 32px;
  }

  .meli-notfound__header {
    position: relative;
    z-index: 5;
    border-bottom: 2px solid var(--meli-ink);
    background: rgb(255 248 240 / 88%);
    backdrop-filter: blur(16px);
  }

  .meli-notfound__nav {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .meli-notfound__brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--meli-ink);
    text-decoration: none;
  }

  .meli-notfound__brand strong {
    font-size: 1.15rem;
    font-variation-settings: 'MONO' 0, 'CASL' 0.45, 'wght' 780;
    letter-spacing: -0.04em;
  }

  :global(.meli-notfound__glyph) {
    width: 30px;
    height: 30px;
    color: var(--meli-cat-fire);
  }

  .meli-notfound__route-label {
    padding: 9px 12px;
    border: 2px solid var(--meli-ink);
    background: var(--meli-paper);
    color: var(--meli-ink);
    font-family: var(--meli-mono);
    font-size: 0.72rem;
    font-variation-settings: 'MONO' 1, 'CASL' 0, 'wght' 760;
    letter-spacing: 0.12em;
  }

  .meli-notfound__hero {
    flex: 1;
    display: grid;
    align-items: center;
    padding-block: clamp(52px, 7vw, 96px);
  }

  .meli-notfound__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    align-items: center;
    gap: clamp(52px, 8vw, 120px);
  }

  .meli-notfound__copy {
    position: relative;
    z-index: 2;
  }

  .meli-notfound__copy h1 {
    max-width: 720px;
    margin: 0;
    color: var(--meli-ink);
    font-size: clamp(4rem, 8vw, 7.3rem);
    font-variation-settings: 'MONO' 0, 'CASL' 0.2, 'wght' 820, 'slnt' -5, 'CRSV' 0.5;
    font-weight: 820;
    letter-spacing: -0.075em;
    line-height: 0.88;
    text-wrap: balance;
  }

  .meli-notfound__copy h1 em {
    display: block;
    color: var(--meli-cat-fire);
    font-variation-settings: 'MONO' 0, 'CASL' 1, 'wght' 720, 'slnt' -8, 'CRSV' 1;
    font-style: normal;
  }

  .meli-notfound__lead {
    max-width: 56ch;
    margin: 30px 0 0;
    color: color-mix(in srgb, var(--meli-ink) 72%, transparent);
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
    font-variation-settings: 'MONO' 0, 'CASL' 0.35, 'wght' 440;
    line-height: 1.65;
  }

  .meli-notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  .meli-notfound__reassurance {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 28px 0 0;
    color: color-mix(in srgb, var(--meli-ink) 66%, transparent);
    font-family: var(--meli-mono);
    font-size: 0.78rem;
    font-variation-settings: 'MONO' 1, 'CASL' 0, 'wght' 650;
    letter-spacing: 0.035em;
  }

  .meli-notfound__reassurance span {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    background: var(--meli-growth);
    color: var(--meli-ink);
    font-weight: 850;
  }

  .meli-notfound__scene {
    position: relative;
    min-height: min(560px, 62vh);
    overflow: hidden;
    border: 4px solid var(--meli-ink);
    background:
      radial-gradient(circle at 62% 38%, rgb(248 82 57 / 22%), transparent 34%),
      linear-gradient(rgb(255 248 240 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 248 240 / 5%) 1px, transparent 1px),
      var(--meli-ink);
    background-size: auto, 28px 28px, 28px 28px, auto;
    box-shadow: 12px 12px 0 var(--meli-cat-shadow);
    isolation: isolate;
  }

  .meli-notfound__scene::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, transparent 0 70%, rgb(248 82 57 / 9%) 70% 100%);
  }

  .meli-notfound__corner {
    position: absolute;
    z-index: 3;
    width: 44px;
    height: 18px;
    background: var(--meli-cat-fire);
  }

  .meli-notfound__corner--top {
    top: 0;
    left: 0;
  }

  .meli-notfound__corner--bottom {
    right: 0;
    bottom: 0;
  }

  .meli-notfound__digits {
    position: absolute;
    inset: 20px 24px auto;
    display: flex;
    justify-content: space-between;
    color: rgb(255 248 240 / 8%);
    font-family: var(--meli-mono);
    font-size: clamp(6rem, 14vw, 11rem);
    font-variation-settings: 'MONO' 1, 'CASL' 0, 'wght' 900;
    font-weight: 900;
    letter-spacing: -0.12em;
    line-height: 1;
    user-select: none;
  }

  .meli-notfound__speech {
    position: absolute;
    z-index: 3;
    top: 52px;
    right: 34px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 14px;
    border: 1px solid rgb(255 248 240 / 24%);
    background: var(--meli-ink-raised);
    color: var(--meli-milk);
    font-family: var(--meli-mono);
    font-size: 0.72rem;
    font-variation-settings: 'MONO' 1, 'CASL' 0, 'wght' 720;
    letter-spacing: 0.09em;
  }

  .meli-notfound__speech span {
    width: 9px;
    height: 9px;
    background: var(--meli-pending);
  }

  :global(.meli-notfound__mascot) {
    position: absolute;
    z-index: 2;
    right: 50%;
    bottom: 104px;
    width: min(56%, 290px);
    transform: translateX(50%);
    filter: drop-shadow(10px 12px 0 rgb(207 52 51 / 34%));
    animation: meli-searching 3.8s ease-in-out infinite;
  }

  .meli-notfound__rail {
    position: absolute;
    right: 34px;
    bottom: 31px;
    left: 34px;
    z-index: 4;
  }

  .meli-notfound__rail-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: 11px;
    color: rgb(255 248 240 / 66%);
    font-family: var(--meli-mono);
    font-size: 0.62rem;
    font-variation-settings: 'MONO' 1, 'CASL' 0, 'wght' 680;
    letter-spacing: 0.08em;
  }

  .meli-notfound__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(11, 1fr);
    gap: 8px;
  }

  .meli-notfound__track > span {
    height: 9px;
    background: var(--meli-milk);
  }

  .meli-notfound__track > span.is-missing {
    background: rgb(255 248 240 / 15%);
  }

  .meli-notfound__track > i {
    position: absolute;
    top: -4px;
    left: 0;
    width: 17px;
    height: 17px;
    background: var(--meli-cat-fire);
    box-shadow: 3px 3px 0 var(--meli-cat-shadow);
    animation: route-break 3.2s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .meli-notfound__footer {
    border-top: 2px solid var(--meli-ink);
    background: var(--meli-cat-fire);
    color: var(--meli-ink);
  }

  .meli-notfound__footer .meli-container {
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--meli-mono);
    font-size: 0.72rem;
    font-variation-settings: 'MONO' 1, 'CASL' 0, 'wght' 720;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @keyframes meli-searching {
    0%, 100% { transform: translateX(50%) translateY(0) rotate(0deg); }
    45% { transform: translateX(50%) translateY(-5px) rotate(-1deg); }
    60% { transform: translateX(50%) translateY(-5px) rotate(1deg); }
  }

  @keyframes route-break {
    0% { left: 0; opacity: 0; }
    8% { opacity: 1; }
    68%, 82% { left: calc(72.7% - 17px); opacity: 1; }
    92%, 100% { left: calc(72.7% - 17px); opacity: 0; }
  }

  @media (max-width: 900px) {
    .meli-notfound__hero {
      padding-block: 48px 68px;
    }

    .meli-notfound__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .meli-notfound__copy {
      max-width: 680px;
    }

    .meli-notfound__scene {
      width: min(100%, 590px);
      min-height: 500px;
      margin-inline: auto;
    }
  }

  @media (max-width: 560px) {
    .meli-container {
      width: min(calc(100% - 32px), var(--meli-container));
    }

    .meli-notfound__nav {
      min-height: 68px;
    }

    .meli-notfound__copy h1 {
      font-size: clamp(3.5rem, 18vw, 5.15rem);
    }

    .meli-notfound__actions {
      display: grid;
    }

    .meli-notfound__actions .meli-button {
      width: 100%;
    }

    .meli-notfound__scene {
      min-height: 430px;
      box-shadow: 8px 8px 0 var(--meli-cat-shadow);
    }

    .meli-notfound__digits {
      inset-inline: 18px;
      font-size: clamp(5rem, 26vw, 8rem);
    }

    .meli-notfound__speech {
      top: 24px;
      right: 20px;
    }

    :global(.meli-notfound__mascot) {
      bottom: 92px;
      width: min(64%, 240px);
    }

    .meli-notfound__rail {
      right: 20px;
      bottom: 25px;
      left: 20px;
    }

    .meli-notfound__route-label,
    .meli-notfound__footer span:last-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.meli-notfound__mascot),
    .meli-notfound__track > i {
      animation: none;
    }

    .meli-notfound__track > i {
      left: calc(72.7% - 17px);
    }
  }
</style>
