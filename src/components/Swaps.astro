---
import { Image } from 'astro:assets';
import TokenIcon from './TokenIcon.astro';
import swapShot from '../assets/shot-swap.png';
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    title: 'Cambia sin salir del ciclo.',
    copy: 'Convierte entre USDC y ETH dentro de GatoPago. Ves la cotización, el mínimo que recibirás y los costos conocidos antes de confirmar.',
    alt: 'Pantalla de cambio en GatoPago con cotización, mínimo recibido y costos visibles',
  },
  en: {
    title: 'Swap without leaving the cycle.',
    copy: 'Convert between USDC and ETH inside GatoPago. See the quote, minimum received, and known costs before confirming.',
    alt: 'GatoPago swap screen with quote, minimum received, and visible costs',
  },
}[lang];

const swaps = [
  { from: 'USDC', to: 'ETH' },
  { from: 'ETH', to: 'USDC' },
] as const;
---

<section id="swaps" class="landing-section">
  <div class="landing-shell">
    <div class="split" data-reveal>
      <div class="split-copy">
        <h2 class="section-title">{t.title}</h2>
        <p class="section-copy">{t.copy}</p>

        <div class="swap-pairs" data-reveal-stagger>
          {swaps.map((swap) => (
            <article class="feature-card swap-row">
              <span class="flex items-center gap-3">
                <TokenIcon token={swap.from} className="!w-11 !h-11" />
                <span class="card-title text-[19px]">{swap.from}</span>
              </span>
              <span class="swap-divider">
                <span class="transfer-dot block h-3 w-3 rounded-full"></span>
              </span>
              <span class="flex items-center gap-3">
                <TokenIcon token={swap.to} className="!w-11 !h-11" />
                <span class="card-title text-[19px]">{swap.to}</span>
              </span>
            </article>
          ))}
        </div>
      </div>

      <div class="split-visual">
        <div class="stage glow-pink">
          <div class="app-screen">
            <Image src={swapShot} alt={t.alt} width={1080} height={2301} loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
