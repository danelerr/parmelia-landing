---
import { getLang } from '../i18n';
import GatoPagoMark from './GatoPagoMark.astro';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    title: 'Tu dinero sigue siendo tuyo. Ahora puede hacer más.',
    copy: 'GatoPago simplifica pagos, cambios y crecimiento sin quedarse con tus fondos. Tú autorizas cada movimiento desde tu cuenta.',
    micro: 'Abstracción sin opacidad: la experiencia es simple, pero las rutas, riesgos y comprobantes siguen disponibles.',
    points: [
      { dot: 'var(--glow-sky)', title: 'Tú autorizas', desc: 'Cada movimiento requiere una llave activa de tu cuenta. GatoPago no custodia el saldo.' },
      { dot: 'var(--glow-pink)', title: 'Recuperación con tiempo', desc: 'Un cambio asistido de llaves espera 48 horas y una llave activa puede cancelarlo.' },
      { dot: 'var(--glow-gold)', title: 'Todo deja rastro', desc: 'Puedes consultar actividad, comprobantes y transacciones onchain.' },
    ],
  },
  en: {
    title: 'Your money stays yours. Now it can do more.',
    copy: 'GatoPago simplifies payments, swaps, and growth without taking custody of your funds. You authorize every movement from your account.',
    micro: 'Abstraction without opacity: the experience stays simple while routes, risks, and receipts remain available.',
    points: [
      { dot: 'var(--glow-sky)', title: 'You authorize', desc: 'Every movement requires an active key from your account. GatoPago does not custody the balance.' },
      { dot: 'var(--glow-pink)', title: 'Recovery with time to react', desc: 'An assisted key change waits 48 hours and an active key can cancel it.' },
      { dot: 'var(--glow-gold)', title: 'Everything leaves a trail', desc: 'You can review activity, receipts, and onchain transactions.' },
    ],
  },
}[lang];
const points = t.points;
---

<section id="control" class="landing-section">
  <div class="landing-shell">
    <div class="split is-reverse" data-reveal>
      <div class="split-visual">
        <div class="stage glow-sky vault-visual" style="margin:0;">
          <div class="vault-mark-frame" aria-hidden="true">
            <GatoPagoMark className="vault-mark" decorative />
            <span class="vault-lock">
              <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 28V22C18 14.3 24.3 8 32 8C39.7 8 46 14.3 46 22V28" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
                <rect x="11" y="27" width="42" height="31" rx="12" fill="rgba(255,255,255,.1)" stroke="currentColor" stroke-width="4"/>
                <path class="check-path" d="M23 42L29 48L42 35" stroke="#9CE3F4" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </div>
      </div>

      <div class="split-copy">
        <h2 class="section-title">{t.title}</h2>
        <p class="section-copy">{t.copy}</p>

        <div class="point-list" data-reveal-stagger>
          {points.map((point) => (
            <div class="point-row">
              <span class="dot" style={`background:${point.dot}; color:${point.dot};`}></span>
              <p><strong style="color:var(--color-text); font-weight:600;">{point.title}.</strong> {point.desc}</p>
            </div>
          ))}
        </div>

        <p class="microcopy" style="text-align:left; margin:6px 0 0;">{t.micro}</p>
      </div>
    </div>
  </div>
</section>
