---
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    title: 'Trae USDC y déjalo listo para usar.',
    copy: 'Mueve fondos desde una wallet o red compatible. GatoPago te guía por la ruta y muestra el resultado antes de convertirlo en saldo Disponible.',
    ribbon1: 'Desde una wallet compatible',
    ribbon2: 'USDC Disponible',
    cards: [
      { mark: '01', title: 'Ruta visible' },
      { mark: '02', title: 'Monto confirmado' },
      { mark: '03', title: 'Listo para usar' },
    ],
  },
  en: {
    title: 'Bring USDC in and make it ready to use.',
    copy: 'Move funds from a compatible wallet or network. GatoPago guides the route and shows the result before it becomes Available balance.',
    ribbon1: 'From a compatible wallet',
    ribbon2: 'Available USDC',
    cards: [
      { mark: '01', title: 'Visible route' },
      { mark: '02', title: 'Confirmed amount' },
      { mark: '03', title: 'Ready to use' },
    ],
  },
}[lang];
const cards = t.cards;
---

<section id="cross-chain" class="landing-section">
  <div class="landing-shell">
    <div class="copy-stack" data-reveal>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-copy">{t.copy}</p>
    </div>

    <div class="bridge-ribbons" data-reveal>
      <div class="bridge-line"><span>{t.ribbon1}</span></div>
      <div class="bridge-line"><span>{t.ribbon2}</span></div>
    </div>

    <div class="feature-grid" data-reveal-stagger>
      {cards.map((card) => (
        <article class="feature-card">
          <span class="card-mark">{card.mark}</span>
          <h3 class="card-title">{card.title}</h3>
        </article>
      ))}
    </div>
  </div>
</section>
