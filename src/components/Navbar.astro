---
import { getLang } from '../i18n';
import { appLink } from '../config/brand';
import GatoPagoMark from './GatoPagoMark.astro';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    links: [
      { href: '#payment-links', label: 'Recibir' },
      { href: '#earn', label: 'Crecer' },
      { href: '#qr-usernames', label: 'Usar' },
      { href: '#coming', label: 'Card' },
      { href: '#api', label: 'Developers' },
    ],
    cta: 'Probar la alpha',
    open: 'Abrir menú',
    close: 'Cerrar menú',
    altLangHref: '/en/',
    altLangLabel: 'EN',
    altLangTitle: 'Read in English',
    altLang: 'en',
  },
  en: {
    links: [
      { href: '#payment-links', label: 'Receive' },
      { href: '#earn', label: 'Grow' },
      { href: '#qr-usernames', label: 'Use' },
      { href: '#coming', label: 'Card' },
      { href: '#api', label: 'Developers' },
    ],
    cta: 'Try the alpha',
    open: 'Open menu',
    close: 'Close menu',
    altLangHref: '/',
    altLangLabel: 'ES',
    altLangTitle: 'Leer en español',
    altLang: 'es',
  },
}[lang];
const links = t.links;
const navAppHref = appLink('landing_nav');
const menuAppHref = appLink('landing_nav_menu');
---

<header class="site-nav">
  <div class="site-nav-inner">
    <a href="#hero" class="site-nav-brand" aria-label="GatoPago — inicio">
      <GatoPagoMark decorative loading="eager" />
      <span>GatoPago</span>
    </a>

    <nav class="site-nav-links" aria-label="Secciones">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="site-nav-actions">
      <a
        href={t.altLangHref}
        class="site-nav-lang"
        title={t.altLangTitle}
        aria-label={t.altLangTitle}
        data-locale-choice={t.altLang}
      >
        {t.altLangLabel}
      </a>

      <a href={navAppHref} target="_blank" rel="noopener noreferrer" class="site-nav-cta" data-cta="nav">
        {t.cta}
      </a>

      <button
        class="site-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav-menu"
        aria-label={t.open}
        data-open={t.open}
        data-close={t.close}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line class="bar-top" x1="4" y1="8" x2="20" y2="8" />
          <line class="bar-bottom" x1="4" y1="16" x2="20" y2="16" />
        </svg>
      </button>
    </div>

    <nav class="site-nav-menu" id="site-nav-menu" aria-label="Secciones" hidden>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href={t.altLangHref} class="site-nav-menu-lang" data-locale-choice={t.altLang}>{t.altLangTitle}</a>
      <a href={menuAppHref} target="_blank" rel="noopener noreferrer" class="site-nav-cta menu-cta" data-cta="nav_menu">
        {t.cta}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav-toggle');
  const menu = document.querySelector<HTMLElement>('.site-nav-menu');

  if (toggle && menu) {
    const openLabel = toggle.dataset.open || 'Open menu';
    const closeLabel = toggle.dataset.close || 'Close menu';
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      toggle.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => setOpen(!!menu.hidden));

    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (!menu.hidden && e.target instanceof Node && !toggle.contains(e.target) && !menu.contains(e.target)) {
        setOpen(false);
      }
    });
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-locale-choice]').forEach((link) => {
    link.addEventListener('click', () => {
      const locale = link.dataset.localeChoice;
      if (locale !== 'es' && locale !== 'en') return;

      try {
        window.localStorage.setItem('gatopago:preferred-locale', locale);
      } catch {
        // Ignore unavailable storage; the next page still loads normally.
      }
    });
  });
</script>
