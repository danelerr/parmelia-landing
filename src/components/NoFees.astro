---
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    title: 'El costo también debe ser fácil de entender.',
    copy: 'GatoPago cobra 0% de comisión por mover saldo entre sus usuarios. Una red, un protocolo o un proveedor externo pueden tener costos propios.',
    micro: 'Cualquier costo conocido aparece antes de que autorices el movimiento.',
    beforeLabel: 'Lo que cansa',
    beforeTitle: 'Cambiar de app y adivinar costos.',
    beforeCopy: 'El problema no es solo cuánto pagas: es no saberlo hasta el final.',
    afterLabel: 'Con GatoPago',
    afterTitle: 'Monto, destinatario y costo a la vista.',
    afterCopy: 'Primero entiendes el movimiento. Después decides si confirmarlo.',
    burn: '0% de GatoPago entre usuarios. Otros costos, siempre visibles.',
  },
  en: {
    title: 'Cost should be easy to understand too.',
    copy: 'GatoPago charges a 0% fee to move balances between its users. A network, protocol, or external provider may have costs of its own.',
    micro: 'Any known cost appears before you authorize the movement.',
    beforeLabel: 'What gets tiring',
    beforeTitle: 'Switching apps and guessing costs.',
    beforeCopy: 'The problem is not only what you pay. It is finding out at the end.',
    afterLabel: 'With GatoPago',
    afterTitle: 'Amount, recipient, and cost in view.',
    afterCopy: 'First you understand the movement. Then you decide whether to confirm it.',
    burn: '0% GatoPago fee between users. Other costs, always visible.',
  },
}[lang];
---

<section id="no-fees" class="landing-section">
  <div class="landing-shell">
    <div class="copy-stack" data-reveal>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-copy">{t.copy}</p>
      <p class="microcopy">{t.micro}</p>
    </div>

    <div class="fee-compare" data-reveal-stagger>
      <article class="fee-panel">
        <p class="text-sm font-semibold uppercase tracking-wide text-white/40">{t.beforeLabel}</p>
        <h3 class="mt-4 font-display text-2xl font-extrabold leading-tight tracking-tight text-white">{t.beforeTitle}</h3>
        <p class="mt-4 text-base font-normal leading-relaxed text-white/60">{t.beforeCopy}</p>
      </article>

      <article class="fee-panel highlight">
        <p class="text-sm font-semibold uppercase tracking-wide text-white/55">{t.afterLabel}</p>
        <h3 class="mt-4 font-display text-2xl font-extrabold leading-tight tracking-tight text-white">{t.afterTitle}</h3>
        <p class="mt-4 text-base font-normal leading-relaxed text-white/70">{t.afterCopy}</p>
      </article>
    </div>

    <div class="fee-burn" data-reveal>
      <svg viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- gas / fees rising and vanishing to nothing -->
        <circle class="gas-particle" cx="100" cy="92" r="8" fill="#F4A9CF" />
        <circle class="gas-particle" cx="80" cy="104" r="5" fill="#EFE08C" />
        <circle class="gas-particle" cx="120" cy="98" r="6" fill="#9CE3F4" />
        <!-- the value that stays -->
        <polygon points="100,96 138,115 100,134 62,115" fill="#A7D4DE" />
      </svg>
      <p class="microcopy" style="margin-top:6px;">{t.burn}</p>
    </div>
  </div>
</section>
