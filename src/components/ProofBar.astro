---
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    stages: [
      { step: '01', value: 'Recibe', label: 'Links, QR o transferencias en USDC' },
      { step: '02', value: 'Disponible', label: 'Listo para pagar, enviar o cambiar' },
      { step: '03', value: 'Creciendo', label: 'Una parte puede generar rendimiento con Aave' },
      { step: '04', value: 'Usa', label: 'Paga, envía o retira cuando la necesites' },
    ],
    note: 'Un solo ciclo para tu dinero. Hoy puedes probarlo con fondos de prueba en Arbitrum Sepolia.',
  },
  en: {
    stages: [
      { step: '01', value: 'Receive', label: 'Links, QR, or USDC transfers' },
      { step: '02', value: 'Available', label: 'Ready to pay, send, or swap' },
      { step: '03', value: 'Growing', label: 'Part of it can earn through Aave' },
      { step: '04', value: 'Use', label: 'Pay, send, or withdraw when needed' },
    ],
    note: 'One cycle for your money. You can try it today with test funds on Arbitrum Sepolia.',
  },
}[lang];
---

<section id="money-cycle" class="proof-bar proof-cycle" data-reveal>
  <div class="proof-inner">
    {t.stages.map((stage) => (
      <div class="proof-stat">
        <span class="proof-step">{stage.step}</span>
        <span class="proof-value">{stage.value}</span>
        <span class="proof-label">{stage.label}</span>
      </div>
    ))}
  </div>

  <p class="proof-note">{t.note}</p>
</section>
