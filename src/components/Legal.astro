---
import '../styles/global.css';
import Footer from './Footer.astro';
import { getLang } from '../i18n';
import GatoPagoMark from './GatoPagoMark.astro';

const lang = getLang(Astro.currentLocale);
const path = Astro.url.pathname; // e.g. /privacy or /en/privacy

// Equivalent page in the other language
const altHref = lang === 'en' ? path.replace(/^\/en/, '') || '/' : `/en${path}`;
const home = lang === 'en' ? '/en/' : '/';

const t = {
  es: { back: 'Volver al inicio', altLabel: 'EN', altTitle: 'Read in English' },
  en: { back: 'Back to home', altLabel: 'ES', altTitle: 'Leer en español' },
}[lang];
---

<header class="legal-top">
  <a href={home} class="site-nav-brand" aria-label="GatoPago — inicio">
    <GatoPagoMark decorative loading="eager" />
    <span>GatoPago</span>
  </a>

  <div class="legal-top-actions">
    <a href={altHref} class="site-nav-lang" title={t.altTitle} aria-label={t.altTitle}>{t.altLabel}</a>
    <a href={home} class="legal-back">{t.back}</a>
  </div>
</header>

<main class="legal">
  <slot />
</main>

<Footer />
