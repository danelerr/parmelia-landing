---
import { Image } from 'astro:assets';
import dashboardShot from '../assets/shot-dashboard.png';
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    title: 'Una cuenta que empieza fácil.',
    copy: 'La abres desde el navegador y entras con tu huella o tu cara. Sin descargar otra app ni guardar una frase semilla.',
    alt: 'Cuenta GatoPago con USDC disponible, saldo creciendo y actividad reciente',
  },
  en: {
    title: 'An account that starts simple.',
    copy: 'Open it in your browser and sign in with your fingerprint or face. No extra app to download and no seed phrase to store.',
    alt: 'GatoPago account with available USDC, growing balance, and recent activity',
  },
}[lang];
---

<section id="browser-first" class="landing-section">
  <div class="landing-shell">
    <div class="browser-card" data-reveal>
      <div class="browser-copy">
        <h2 class="section-title">{t.title}</h2>
        <p class="section-copy">{t.copy}</p>

        <svg class="bridge-cross" viewBox="0 0 260 170" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <polygon points="52,70 88,88 52,106 16,88" fill="#DEA6BC" />
          <polygon points="208,70 244,88 208,106 172,88" fill="#A7D4DE" />
          <path class="bridge-arc" d="M 72,78 Q 130,24 188,78" fill="none" stroke="#F5F5F3" stroke-width="4" stroke-linecap="round" />
          <path class="bridge-arc bridge-arc-delay" d="M 72,98 Q 130,150 188,98" fill="none" stroke="#F5F5F3" stroke-width="4" stroke-linecap="round" />
        </svg>
      </div>

      <div class="app-screen" data-float>
        <Image src={dashboardShot} alt={t.alt} width={1080} height={2400} loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>
