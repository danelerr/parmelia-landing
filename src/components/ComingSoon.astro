---
import CardGlyphs from './CardGlyphs.astro';
import GatoPagoMark from './GatoPagoMark.astro';
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    badge: 'Acceso anticipado',
    title: 'La próxima frontera es usarlo fuera de GatoPago.',
    copy: 'Estamos validando una GatoPago Card para gastar dólares digitales y mejores puentes con el QR de Bolivia. Todavía no está activa: cobertura, proveedor y requisitos siguen en evaluación.',
    cardLabel: 'Saldo en USDC',
    points: [
      { dot: 'var(--glow-gold)', title: 'GatoPago Card', status: 'En validación', desc: 'Queremos conectar el saldo Disponible con pagos cotidianos sin perder el control del core onchain.' },
      { dot: 'var(--glow-sky)', title: 'Entrada y salida local', status: 'Investigación', desc: 'Estamos estudiando cómo conectar mejor USDC con los hábitos de pago de Bolivia.' },
      { dot: 'var(--glow-pink)', title: 'Condiciones claras', status: 'Compromiso', desc: 'Elegibilidad, costos y cualquier verificación requerida se mostrarán antes de ofrecer el servicio.' },
    ],
  },
  en: {
    badge: 'Early access',
    title: 'The next frontier is using it beyond GatoPago.',
    copy: 'We are validating a GatoPago Card for spending digital dollars and better bridges to Bolivia’s QR system. It is not active yet: coverage, provider, and requirements are still under evaluation.',
    cardLabel: 'USDC balance',
    points: [
      { dot: 'var(--glow-gold)', title: 'GatoPago Card', status: 'Validating', desc: 'We want to connect Available balance to everyday payments without giving up control of the onchain core.' },
      { dot: 'var(--glow-sky)', title: 'Local money in and out', status: 'Research', desc: 'We are studying how to connect USDC with Bolivia’s existing payment habits.' },
      { dot: 'var(--glow-pink)', title: 'Clear conditions', status: 'Commitment', desc: 'Eligibility, costs, and any required verification will be shown before the service is offered.' },
    ],
  },
}[lang];
const points = t.points;
---

<section id="coming" class="landing-section">
  <div class="landing-shell">
    <div class="split" data-reveal>
      <div class="split-copy">
        <span class="soon-badge"><span class="soon-dot" aria-hidden="true"></span> {t.badge}</span>
        <h2 class="section-title">{t.title}</h2>
        <p class="section-copy">{t.copy}</p>

        <div class="point-list" data-reveal-stagger>
          {points.map((point) => (
            <div class="point-row">
              <span class="dot" style={`background:${point.dot}; color:${point.dot};`}></span>
              <p>
                <span class="point-head">
                  <strong style="color:var(--color-text); font-weight:600;">{point.title}</strong>
                  <span class="point-tag">{point.status}</span>
                </span>
                {point.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="split-visual">
        <div class="stage glow-pink">
          <div class="stable-card">
            <CardGlyphs />
            <div class="stable-card__top">
              <span class="stable-card__brand">GatoPago</span>
              <svg class="stable-card__wave" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M8.5 8.5a5 5 0 0 1 0 7" />
                <path d="M11.5 6a8.5 8.5 0 0 1 0 12" />
                <path d="M14.5 3.5a12 12 0 0 1 0 17" />
              </svg>
            </div>

            <span class="stable-card__chip" aria-hidden="true"></span>

            <div class="stable-card__number" aria-hidden="true">
              <span>5274</span><span>88••</span><span>••••</span><span>0420</span>
            </div>

            <div class="stable-card__bottom">
              <span class="stable-card__col">
                <span class="stable-card__label">{t.cardLabel}</span>
                <span class="stable-card__value">$ 1,240.00</span>
              </span>
              <span class="stable-card__logo" aria-hidden="true">
                <GatoPagoMark decorative />
              </span>
            </div>
          </div>

          <div class="rail-hint" aria-hidden="true">
            <span class="rail-node">QR Bs.</span>
            <span class="rail-flow"><span class="rail-dot"></span></span>
            <span class="rail-node">USDC</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
