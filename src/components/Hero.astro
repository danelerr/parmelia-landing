---
import GatoPagoMark from './GatoPagoMark.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import { getLang } from '../i18n';
import { appLink } from '../config/brand';

const lang = getLang(Astro.currentLocale);
const heroAppHref = appLink('landing_hero');
const t = {
  es: {
    titleLead: 'Recibe, usa y haz crecer',
    titleAccent: 'tus dólares digitales.',
    copy: 'Cobra, paga, cambia y pon a trabajar una parte de tus USDC desde una cuenta que controlas.',
    cta: 'Probar la alpha',
    how: 'Ver el ciclo',
    proof: ['Tu dinero sigue siendo tuyo', 'USDC primero', 'sin frases semilla'],
		alpha: 'Alpha pública · Arbitrum Sepolia · fondos de prueba',
  },
  en: {
    titleLead: 'Receive, use and grow',
    titleAccent: 'your digital dollars.',
    copy: 'Get paid, pay, swap, and put part of your USDC to work from an account you control.',
    cta: 'Try the alpha',
    how: 'See the cycle',
    proof: ['Your money stays yours', 'USDC first', 'no seed phrase'],
		alpha: 'Public alpha · Arbitrum Sepolia · test funds',
  },
}[lang];
---

<section id="hero" class="hero-section hero-dark">
  <HeroBackdrop />

  <div class="landing-shell">
    <div class="copy-stack wide" data-reveal>
      <GatoPagoMark className="hero-logo-glow" loading="eager" />

      <div class="relative w-full">
        <h1 class="hero-title hero-title-light">
          {t.titleLead} <span class="text-gradient">{t.titleAccent}</span>
        </h1>
      </div>

      <p class="section-copy">{t.copy}</p>
			<p class="microcopy">{t.alpha}</p>

      <div class="button-row">
        <a href={heroAppHref} target="_blank" rel="noopener noreferrer" class="btn-gatopago hero-cta" data-cta="hero">
          {t.cta}
        </a>
        <a href="#money-cycle" class="btn-ghost">{t.how}</a>
      </div>

      <p class="microcopy hero-proofline">
        <span>{t.proof[0]}</span>
        <span class="proof-dot proof-dot-sky" aria-hidden="true"></span>
        <span>{t.proof[1]}</span>
        <span class="proof-dot proof-dot-pink" aria-hidden="true"></span>
        <span>{t.proof[2]}</span>
      </p>
    </div>
  </div>
</section>
