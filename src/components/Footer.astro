---
import { getLang } from '../i18n';
import { appLink, brand } from '../config/brand';
import GatoPagoMark from './GatoPagoMark.astro';

const lang = getLang(Astro.currentLocale);
const prefix = lang === 'en' ? '/en' : '';
const home = `${prefix}/`;
const footerAppHref = appLink('landing_footer');
const footerCtaHref = appLink('landing_footer_cta');
const t = {
  es: {
    tagline: 'Recibe, usa y haz crecer dólares digitales desde una cuenta onchain programable que tú controlas.',
    productHead: 'Producto',
    app: 'Probar la alpha',
    links: 'Recibir con links',
    grow: 'Creciendo',
    qr: 'Pagar y enviar',
    card: 'Card · acceso anticipado',
    api: 'API',
    docs: 'Documentación',
    communityHead: 'Comunidad',
    x: 'X de GatoPago',
    cta: 'Probar la alpha',
    rights: '© 2026 GatoPago. Todos los derechos reservados.',
    madeBy: 'Hecho con cariño por',
    privacy: 'Privacidad',
    terms: 'Términos',
  },
  en: {
    tagline: 'Receive, use, and grow digital dollars from a programmable onchain account you control.',
    productHead: 'Product',
    app: 'Try the alpha',
    links: 'Receive with links',
    grow: 'Growing',
    qr: 'Pay and send',
    card: 'Card · early access',
    api: 'API',
    docs: 'Docs',
    communityHead: 'Community',
    x: 'GatoPago on X',
    cta: 'Try the alpha',
    rights: '© 2026 GatoPago. All rights reserved.',
    madeBy: 'Made with love by',
    privacy: 'Privacy',
    terms: 'Terms',
  },
}[lang];
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-main">
      <div class="footer-brand">
        <a href={home} class="footer-logo-link" aria-label="GatoPago">
          <GatoPagoMark decorative />
          <span>GatoPago</span>
        </a>
        <p>{t.tagline}</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <div class="footer-column">
          <h4>{t.productHead}</h4>
          <a href={footerAppHref} target="_blank" rel="noopener noreferrer" data-cta="footer_app">{t.app}</a>
          <a href={`${home}#payment-links`}>{t.links}</a>
          <a href={`${home}#earn`}>{t.grow}</a>
          <a href={`${home}#qr-usernames`}>{t.qr}</a>
          <a href={`${home}#coming`}>{t.card}</a>
          <a href={`${home}#api`}>{t.api}</a>
          <a href="/docs">{t.docs}</a>
        </div>

        <div class="footer-column">
          <h4>{t.communityHead}</h4>
          {brand.socialUrl && <a href={brand.socialUrl} target="_blank" rel="noopener noreferrer">{t.x}</a>}
          <a href="https://danielcueto.me" target="_blank" rel="noopener noreferrer">Daniel Cueto</a>
          <a href="https://x.com/danelerr" target="_blank" rel="noopener noreferrer">@danelerr</a>
        </div>
      </nav>

      <div class="footer-cta">
        <a href={footerCtaHref} target="_blank" rel="noopener noreferrer" data-cta="footer_cta">
          {t.cta}
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">
        <a href={`${prefix}/privacy`}>{t.privacy}</a>
        <span aria-hidden="true">·</span>
        <a href={`${prefix}/terms`}>{t.terms}</a>
      </p>
      <p>{t.rights}</p>
      <p>
        {t.madeBy} <a href="https://danielcueto.me" target="_blank" rel="noopener noreferrer">Daniel Cueto</a>
      </p>
    </div>
  </div>
</footer>
