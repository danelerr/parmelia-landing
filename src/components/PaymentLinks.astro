---
import { Image } from 'astro:assets';
import ShareChannels from './ShareChannels.astro';
import GatoPagoMark from './GatoPagoMark.astro';
import chargeShot from '../assets/shot-charge.png';
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  es: {
    title: 'Primero, haz que el dinero llegue.',
    copy: 'Crea un cobro en USDC y comparte el link donde ya hablas con tus clientes o tu comunidad. En la Alpha, quien paga entra a GatoPago antes de confirmar.',
    tags: ['Trabajo freelance', 'Grants', 'Comunidades', 'Ventas directas'],
    share: 'El cobro viaja contigo',
    alt: 'Link de cobro en GatoPago con QR, monto en USDC y botón para compartir',
  },
  en: {
    title: 'First, get the money in.',
    copy: 'Create a USDC charge and share the link wherever you already talk with clients or your community. In the Alpha, the payer signs in to GatoPago before confirming.',
    tags: ['Freelance work', 'Grants', 'Communities', 'Direct sales'],
    share: 'The charge travels with you',
    alt: 'GatoPago payment link with QR, USDC amount and a share button',
  },
}[lang];
---

<section id="payment-links" class="landing-section">
  <div class="landing-shell">
    <div class="split" data-reveal>
      <div class="split-copy">
        <h2 class="section-title">{t.title}</h2>
        <p class="section-copy">{t.copy}</p>
        <div class="pill-row">
          {t.tags.map((tag) => (
            <span class="pill">{tag}</span>
          ))}
        </div>
      </div>

      <div class="split-visual">
        <div class="stage glow-pink">
          <div class="app-screen">
            <Image src={chargeShot} alt={t.alt} width={1080} height={2400} loading="lazy" decoding="async" />
          </div>

          <div class="payment-transfer" aria-hidden="true">
            <GatoPagoMark className="payment-transfer__mark" decorative />
            <span class="payment-transfer__line"><span class="p2p-transfer-dot"></span></span>
            <GatoPagoMark className="payment-transfer__mark" decorative />
          </div>

          <ShareChannels label={t.share} />
        </div>
      </div>
    </div>
  </div>
</section>
