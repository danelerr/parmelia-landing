<script>
  const SELECTOR = {
    navShell: '[data-nav-shell]',
    menuButton: '[data-menu-button]',
    mobileMenu: '[data-mobile-menu]',
    reveal: '[data-reveal]',
    cycleState: '[data-cycle-state]',
    cycleLab: '[data-cycle-lab]',
    cycleDetail: '[data-cycle-detail]',
    cycleStatus: '[data-cycle-status]',
    cycleExpression: '[data-cycle-expression]',
    napToggle: '[data-nap-toggle]',
    napStatus: '[data-nap-status]',
    catStage: '[data-cat-stage]',
    dialog: '[data-transaction-dialog]',
    dialogOpen: '[data-dialog-open]',
    copyPayment: '[data-copy-payment]',
    copyLabel: '[data-copy-label]',
  } as const;

  const navShell = document.querySelector<HTMLElement>(SELECTOR.navShell);
  const menuButton = document.querySelector<HTMLButtonElement>(SELECTOR.menuButton);
  const mobileMenu = document.querySelector<HTMLElement>(SELECTOR.mobileMenu);

  const closeMenu = () => {
    if (!menuButton || !mobileMenu) return;
    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', menuButton.dataset.openLabel ?? 'Open menu');
    mobileMenu.hidden = true;
    navShell?.classList.remove('is-menu-open');
  };

  menuButton?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const isOpening = menuButton.getAttribute('aria-expanded') !== 'true';
    menuButton.setAttribute('aria-expanded', String(isOpening));
    menuButton.setAttribute('aria-label', isOpening ? (menuButton.dataset.closeLabel ?? 'Close menu') : (menuButton.dataset.openLabel ?? 'Open menu'));
    mobileMenu.hidden = !isOpening;
    navShell?.classList.toggle('is-menu-open', isOpening);
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      menuButton.focus();
    }
  });

  let previousScroll = window.scrollY;
  const syncNav = () => {
    const current = window.scrollY;
    navShell?.classList.toggle('is-scrolled', current > 24);
    navShell?.classList.toggle('is-hidden', current > previousScroll && current > 180 && !navShell.classList.contains('is-menu-open'));
    previousScroll = current;
  };
  window.addEventListener('scroll', syncNav, { passive: true });
  syncNav();

  document.querySelectorAll<HTMLAnchorElement>('[data-locale-link]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        window.localStorage.setItem('gatopago:preferred-locale', link.hreflang === 'en' || link.textContent?.trim() === 'EN' ? 'en' : 'es');
      } catch {}
    });
  });

  const revealElements = [...document.querySelectorAll<HTMLElement>(SELECTOR.reveal)];
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    revealElements.forEach((element) => observer.observe(element));
  } else {
    revealElements.forEach((element) => element.classList.add('is-visible'));
  }

  document.querySelectorAll<HTMLElement>(SELECTOR.cycleLab).forEach((lab) => {
    const states = [...lab.querySelectorAll<HTMLButtonElement>(SELECTOR.cycleState)];
    const detail = lab.querySelector<HTMLElement>(SELECTOR.cycleDetail);
    const status = lab.querySelector<HTMLElement>(SELECTOR.cycleStatus);
    const expression = lab.querySelector<HTMLElement>(SELECTOR.cycleExpression);
    states.forEach((button, index) => {
      button.addEventListener('click', () => {
        states.forEach((state) => {
          state.classList.remove('is-active');
          state.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('is-active');
        button.setAttribute('aria-pressed', 'true');
        lab.style.setProperty('--cycle-index', String(index));
        if (detail) detail.textContent = button.dataset.detail ?? '';
        if (status) status.textContent = button.dataset.status ?? '';
        if (expression) expression.dataset.expression = button.dataset.expression ?? 'focused';
      });
    });
  });

  const napToggle = document.querySelector<HTMLButtonElement>(SELECTOR.napToggle);
  const napStatus = document.querySelector<HTMLElement>(SELECTOR.napStatus);
  const catStage = document.querySelector<HTMLElement>(SELECTOR.catStage);
  napToggle?.addEventListener('click', () => {
    const sleeping = napToggle.getAttribute('aria-pressed') !== 'true';
    napToggle.setAttribute('aria-pressed', String(sleeping));
    catStage?.classList.toggle('is-sleeping', sleeping);
    if (napStatus) napStatus.textContent = sleeping ? (napToggle.dataset.asleep ?? '') : (napToggle.dataset.awake ?? '');
  });

  const dialog = document.querySelector<HTMLDialogElement>(SELECTOR.dialog);
  document.querySelector<HTMLButtonElement>(SELECTOR.dialogOpen)?.addEventListener('click', () => dialog?.showModal());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close('cancel');
  });

  document.querySelectorAll<HTMLButtonElement>(SELECTOR.copyPayment).forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector<HTMLElement>(SELECTOR.copyLabel);
      try { await navigator.clipboard.writeText(button.dataset.paymentLink ?? ''); } catch {}
      if (label) label.textContent = button.dataset.copiedLabel ?? 'Copied';
      button.classList.add('is-copied');
      window.setTimeout(() => {
        if (label) label.textContent = button.dataset.defaultLabel ?? 'Copy link';
        button.classList.remove('is-copied');
      }, 1800);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-cta]').forEach((link) => {
    link.addEventListener('click', () => {
      const plausible = (window as Window & { plausible?: (event: string, options?: unknown) => void }).plausible;
      plausible?.('Open App', { props: { placement: link.dataset.cta ?? 'unknown' } });
    });
  });
</script>
