import { getLang } from '../i18n';
import { appLink, brand, paymentLink } from '../config/brand';
import CatGlyph from './CatGlyph.astro';
import MeliSprite from './MeliSprite.astro';

const lang = getLang(Astro.currentLocale);
const isSpanish = lang === 'es';
const localeHref = isSpanish ? '/en/' : '/';
const localeLabel = isSpanish ? 'EN' : 'ES';
const appHref = appLink(`landing-rebrand-${lang}`);
const legalPrefix = isSpanish ? '' : '/en';
const demoPaymentLink = paymentLink('cafe-norte');
const demoPaymentPath = new URL(demoPaymentLink).pathname;
const cardMailHref = `mailto:${brand.contactEmail}?subject=GatoPago%20Card%20early%20access`;
const apiMailHref = `mailto:${brand.contactEmail}?subject=GatoPago%20API%20pilot`;

