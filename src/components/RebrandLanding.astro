const t = copy[lang];
---

<a class="meli-skip-link" href="#main-content">{t.skip}</a>

<div class="meli-landing" data-locale={lang}>
  <header class="meli-nav-shell" data-nav-shell>
    <nav class="meli-nav" aria-label={t.nav.aria}>
      <a class="meli-brand" href={isSpanish ? '/' : '/en/'} aria-label={t.nav.home}>
        <CatGlyph className="meli-brand__glyph" decorative />
        <span class="meli-brand__word">GatoPago</span>
        <span class="meli-brand__alpha">alpha</span>
      </a>

      <div class="meli-nav__links" data-nav-menu>
        <a href="#cycle">{t.nav.cycle}</a>
        <a href="#account">{t.nav.account}</a>
        <a href="#grow">{t.nav.grow}</a>
        <a href="#card">{t.nav.card}</a>
        <a href="#api">{t.nav.developers}</a>
      </div>

      <div class="meli-nav__actions">
        <a
          class="meli-locale"
          href={localeHref}
          hreflang={isSpanish ? 'en' : 'es'}
          aria-label={t.nav.language}
          data-locale-link
        >{localeLabel}</a>
        <a class="meli-button meli-button--brand meli-nav__cta" href={appHref} data-cta="nav" rel="external">
          {t.nav.open}
          <span aria-hidden="true">↗</span>
        </a>
        <button
          class="meli-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="meli-mobile-menu"
          aria-label={t.nav.menuOpen}
          data-menu-button
          data-open-label={t.nav.menuOpen}
          data-close-label={t.nav.menuClose}
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <div class="meli-mobile-menu" id="meli-mobile-menu" data-mobile-menu hidden>
      <a href="#cycle">{t.nav.cycle}</a>
      <a href="#account">{t.nav.account}</a>
      <a href="#grow">{t.nav.grow}</a>
      <a href="#card">{t.nav.card}</a>
      <a href="#api">{t.nav.developers}</a>
      <a class="meli-button meli-button--brand" href={appHref} data-cta="mobile-nav" rel="external">{t.nav.open} <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="main-content">
    <section class="meli-hero meli-section--ink" id="hero" aria-labelledby="hero-title">
      <div class="meli-ambient-grid" aria-hidden="true"></div>
      <div class="meli-container meli-hero__grid">
        <div class="meli-hero__copy" data-reveal>
          <p class="meli-kicker meli-kicker--light"><span aria-hidden="true"></span>{t.hero.eyebrow}</p>
          <h1 id="hero-title">
            {t.hero.titleLead}<br />
            <span>{t.hero.titleAccent}</span>
          </h1>
          <p class="meli-hero__lead">{t.hero.copy}</p>

          <div class="meli-hero__actions">
            <a class="meli-button meli-button--brand meli-button--large" href={appHref} data-cta="hero" rel="external">
              {t.hero.primary}<span aria-hidden="true">↗</span>
            </a>
            <a class="meli-button meli-button--ghost-light meli-button--large" href="#cycle">
              {t.hero.secondary}<span aria-hidden="true">↓</span>
            </a>
          </div>

          <ul class="meli-alpha-list" aria-label={t.hero.alpha}>
            <li><i aria-hidden="true"></i>{t.hero.alpha}</li>
            <li>{t.hero.network}</li>
            <li>{t.hero.funds}</li>
          </ul>
        </div>

        <div class="meli-hero__visual" data-reveal data-reveal-delay="1">
          <div class="meli-orbit-label meli-orbit-label--top"><span></span>{t.hero.packet}</div>
          <figure class="meli-cat-stage" data-cat-stage>
            <div class="meli-hero-character" role="img" aria-label={t.hero.visualLabel}>
              <MeliSprite variant="head-neutral" className="meli-hero-sprite meli-hero-sprite--awake" loading="eager" />
              <MeliSprite variant="body-sleeping" className="meli-hero-sprite meli-hero-sprite--sleeping" />
              <span class="meli-dream-pixels" aria-hidden="true"><i>Z</i><i>z</i><i>·</i></span>
            </div>
            <figcaption>{t.hero.visualNote}</figcaption>
          </figure>
          <div class="meli-pixel-rail meli-pixel-rail--hero" aria-hidden="true"><span></span></div>
          <button
            class="meli-nap-toggle"
            type="button"
            aria-pressed="false"
            data-nap-toggle
            data-awake={t.hero.napOff}
            data-asleep={t.hero.napOn}
          >
            <span class="meli-nap-toggle__pixel" aria-hidden="true">Z</span>
            <span>{t.hero.nap}</span>
          </button>
          <p class="meli-nap-status" aria-live="polite" data-nap-status>{t.hero.napOff}</p>
        </div>
      </div>
    </section>

    <aside class="meli-signal-strip" aria-label={isSpanish ? 'Principios de producto' : 'Product principles'}>
      <div class="meli-container meli-signal-strip__grid">
        {t.signals.map(([title, text], index) => (
          <div class="meli-signal" data-reveal>
            <span class="meli-signal__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div><strong>{title}</strong><p>{text}</p></div>
          </div>
        ))}
      </div>
    </aside>

