---
import '@fontsource-variable/recursive/full.css';
import { brand } from '../config/brand';

interface Props {
  title?: string;
  description?: string;
  autoLocaleRedirect?: boolean;
}

const lang = (Astro.currentLocale ?? 'es') as 'es' | 'en';

const defaults = {
  es: {
    title: 'GatoPago — Tus dólares ya saben moverse',
    description:
      'Cobra, paga, cambia y haz crecer dólares digitales desde una cuenta que tú controlas. Alpha pública con fondos de prueba en Arbitrum Sepolia.',
  },
  en: {
    title: 'GatoPago — Your dollars already know how to move',
    description:
      'Get paid, pay, swap, and grow digital dollars from an account you control. Public alpha with test funds on Arbitrum Sepolia.',
  },
} as const;

const {
  title = defaults[lang].title,
  description = defaults[lang].description,
  autoLocaleRedirect = false,
} = Astro.props;

const siteUrl = `${brand.siteUrl}/`;
const englishUrl = new URL('/en/', siteUrl).href;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/og.png', siteUrl).href;
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';
const ogImageAlt =
  lang === 'en'
    ? 'GatoPago — your dollars already know how to move'
    : 'GatoPago — tus dólares ya saben moverse';

// Privacy-friendly analytics, off by default. Enable by setting
// PUBLIC_PLAUSIBLE_DOMAIN (the canonical production domain) in the environment / .env.
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#org`,
      name: 'GatoPago',
      alternateName: 'GatoPago Account',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/Logo_gatopago.svg', siteUrl).href,
        caption: 'GatoPago',
      },
      description:
        'Self-custodial programmable onchain account for Bolivia and Latin America. Receive, use and grow digital dollars (USDC), with payments and a developer API.',
      slogan: lang === 'en' ? 'Your dollars already know how to move' : 'Tus dólares ya saben moverse',
      founder: { '@id': `${siteUrl}#founder` },
      areaServed: [{ '@type': 'Country', name: 'Bolivia' }, 'Latin America'],
      knowsAbout: [
        'Stablecoin payments',
        'USDC',
        'Digital dollars',
        'Arbitrum',
        'Programmable onchain accounts',
        'Payment links',
        'QR payments',
        'Guided DeFi with Aave',
      ],
      sameAs: [brand.socialUrl],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#founder`,
      name: 'Daniel Cueto',
      jobTitle: 'Founder',
      worksFor: { '@id': `${siteUrl}#org` },
      url: 'https://danielcueto.me',
      description:
        'Founder of GatoPago and lead of the Ethereum Bolivia community.',
      knowsAbout: [
        'Stablecoin payments',
        'Non-custodial wallets',
        'Arbitrum',
        'Fintech in Latin America',
      ],
      sameAs: ['https://x.com/danelerr', 'https://danielcueto.me'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'GatoPago',
      inLanguage: lang,
      publisher: { '@id': `${siteUrl}#org` },
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}#app`,
      name: 'GatoPago',
      url: brand.appUrl,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      browserRequirements:
        'Requires a modern web browser with passkey (WebAuthn) support. Requires JavaScript.',
      inLanguage: ['es', 'en'],
      description,
      publisher: { '@id': `${siteUrl}#org` },
      featureList: [
        'Receive USDC through payment links, QR codes and transfers',
        'Pay and send to usernames',
        'Swap USDC and ETH with quote and cost details before confirmation',
        'Guided USDC deposits and withdrawals through Aave V3 with a variable rate and visible risks',
        'Self-custodial smart account: each movement requires an active key',
        'Passkey / biometric sign-in (fingerprint or face), no passwords or seed phrases',
        'Works in the browser, no app to download',
        '0% GatoPago fee between users; network, protocol, provider or conversion costs may apply',
        'Withdraw to a compatible external wallet',
        'Payment intents, checkout, sandbox and signed webhooks for pilot integrations',
        'Public Alpha on Arbitrum Sepolia with test funds',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      autoLocaleRedirect && (
        <script
          is:inline
          set:html={`
            (() => {
              const preferenceKey = 'gatopago:preferred-locale';
              const legacyPreferenceKey = 'parmelia:preferred-locale';
              const currentLocale = '${lang}';
              const readPreference = () => {
                try {
                  const value =
                    window.localStorage.getItem(preferenceKey) ??
                    window.localStorage.getItem(legacyPreferenceKey);
                  if (value === 'es' || value === 'en') {
                    window.localStorage.setItem(preferenceKey, value);
                  }
                  return value === 'es' || value === 'en' ? value : null;
                } catch {
                  return null;
                }
              };
              const configuredLanguages =
                Array.isArray(navigator.languages) && navigator.languages.length
                  ? navigator.languages
                  : [navigator.language || ''];
              const primaryLanguage = String(configuredLanguages[0] || '').toLowerCase();
              const targetLocale = readPreference() ?? (primaryLanguage.startsWith('es') ? 'es' : 'en');

              if (targetLocale !== currentLocale) {
                const nextUrl = new URL(targetLocale === 'es' ? '/' : '/en/', window.location.origin);
                nextUrl.search = window.location.search;
                nextUrl.hash = window.location.hash;
                window.location.replace(nextUrl.href);
              }
            })();
          `}
        />
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Canonical + language alternates -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={siteUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="GatoPago" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    {brand.socialHandle && <meta name="twitter:site" content={brand.socialHandle} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Theme color for mobile browser chrome -->
    <meta name="theme-color" content="#0B0B0F" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

    {
      plausibleDomain && (
        <Fragment>
          <script
            defer
            data-domain={plausibleDomain}
            src="https://plausible.io/js/script.outbound-links.js"
            is:inline
          />
          <script is:inline>
            window.plausible = window.plausible || function () {(window.plausible.q = window.plausible.q || []).push(arguments)}
          </script>
        </Fragment>
      )
    }

    <!-- Gate scroll-reveal hiding behind JS availability: without JS the page stays fully visible -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
